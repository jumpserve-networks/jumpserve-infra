{
  "name": "jumpserve-infra",
  "version": "0.1.0",
  "bin": {
    "jumpserve-infra": "bin/jumpserve-infra.js"
  },
  "scripts": {
    "test:research:completion": "python3 -B test/check_autonomy_completion_database.py",
    "test:research:repair": "python3 -B test/check_autonomous_repair_database.py",
    "test:research:assessment-recovery": "python3 -B test/check_assessment_recovery_database.py",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:ami": "python3 -B -m unittest discover -s test -p '*_test.py' -v",
    "test:agent": "python3 -B -m unittest discover -s test -p 'agent*_test.py' -v",
    "test:agent:database": "python3 -B test/check_agent_prompt_database.py",
    "test:database:rls": "python3 -B test/check_database_rls.py",
    "test:database:profiles": "python3 -B test/check_profile_database.py",
    "cdk:benchmark": "cdk --app \"npx ts-node --prefer-ts-exts bin/benchmark.ts\"",
    "cdk:openclaw": "cdk --app \"npx ts-node --prefer-ts-exts bin/openclaw.ts\"",
    "test:research:openclaw": "python3 -B test/check_openclaw_database.py",
    "cdk": "cdk",
    "test:database:ingest": "python3 -B test/check_benchmark_ingest_database.py",
    "test:research:database": "python3 -B test/check_research_workflow_database.py",
    "test:research:queue": "python3 -B test/check_research_queue_database.py",
    "test:research:browser-fixture": "python3 -B test/serve_research_workflow_fixture.py",
    "test:research:ideas": "python3 -B test/check_research_ideas_database.py",
    "test:research:ideas:browser-fixture": "python3 -B test/serve_research_ideas_fixture.py",
    "test:research:autonomy": "python3 -B test/check_autonomy_database.py",
    "test:research:executable-methods": "python3 -B test/check_executable_methods_database.py",
    "test:research:builder": "python3 -B test/check_experiment_builder_database.py",
    "test:research:turn-policy": "python3 -B test/check_autonomy_turn_policy_database.py",
    "test:research:paper-uploads": "python3 -B test/check_paper_upload_database.py",
    "test:research:paper-selection": "python3 -B test/check_paper_selection_database.py",
    "test:research:autonomy:browser-fixture": "python3 -B test/serve_autonomy_fixture.py"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1132.0",
    "@aws-sdk/client-ec2": "^3.1132.0",
    "@aws-sdk/client-secrets-manager": "^3.1132.0",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1118.2",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.248.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.28.0"
  }
}
