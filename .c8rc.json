{
  "all": true,
  "include": ["assets/**/*.js", "assets/**/*.mjs"],
  "exclude": ["**/*.test.js", "**/*.test.mjs"],
  "extension": [".js", ".mjs"],
  "reporter": ["text-summary", "json", "json-summary", "lcov", "html"],
  "reports-dir": "coverage/native",
  "lines": 100,
  "branches": 100,
  "functions": 100,
  "statements": 100,
  "per-file": true
}
