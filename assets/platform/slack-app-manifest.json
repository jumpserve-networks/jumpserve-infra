{
  "display_information": {
    "name": "JumpServe Supervisor",
    "description": "Talk to the AWS-hosted JumpServe platform supervisor",
    "background_color": "#0f172a"
  },
  "features": {
    "bot_user": {"display_name": "JumpServe Supervisor", "always_online": true},
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read", "chat:write", "groups:history", "groups:read",
        "im:history", "im:read", "im:write", "reactions:write", "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {"bot_events": ["app_mention", "message.groups", "message.im"]}
  }
}
